{
  "name": "advice-stock-bot",
  "version": "1.0.0",
  "description": "iPhone 18 Pro Max (256GB / 512GB) stock monitoring bot for Advice (advice.co.th) with LINE / Telegram / Discord alerts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "notify:test": "tsx src/scripts/test-notification.ts",
    "notify:samples": "tsx src/scripts/test-notification.ts --samples",
    "notify:status": "tsx src/scripts/test-notification.ts --status",
    "notify:live": "tsx src/scripts/test-notification.ts --live",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "devalue": "^5.1.1",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
